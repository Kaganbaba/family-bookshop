rules_version = '2';

// Family Bookshop — Firestore güvenlik kuralları
// • Erişim: yalnızca allowedEmails() listesindeki, e-postası doğrulanmış hesaplar.
// • Okuma: yalnızca giriş yapmış (izinli) kullanıcılar.
// • Yönetim (kitap/tür/teklif/duyuru/fiyat logu, bakiye ve rol): yalnızca Kontrolcü.
// • Kiralama: kullanıcı yalnızca kendi adına; bakiyesi tam ödediği tutar kadar düşer,
//   kitap boşta olmalı (books/{id}.lockUntil). Bakiye artırmak yalnızca Kontrolcüye açık.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Yardımcılar ----------
    // Siteye yalnızca bu hesaplar girebilir (index.html → ALLOWED_EMAILS ile aynı olmalı)
    function allowedEmails() {
      return [
        'tolga.kagan2017@gmail.com',
        'duraksenay81@gmail.com',
        'tolga.durak2020@gmail.com',
        'durakceylin167@gmail.com'
      ];
    }
    // "Giriş yapmış" = doğrulanmış e-posta + izinli listede. Diğer herkes hiçbir şeye erişemez.
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in allowedEmails();
    }
    function uid() { return request.auth.uid; }
    function path(c, id) { return /databases/$(database)/documents/$(c)/$(id); }

    // Ana Kontrolcü (index.html → OWNER_EMAIL ile aynı olmalı)
    function isOwner() {
      return signedIn()
        && request.auth.token.email == 'tolga.kagan2017@gmail.com'
        && request.auth.token.email_verified == true;
    }
    // Profil belgesi yoksa get() hata verir → kural reddeder
    function me() { return get(path('users', uid())).data; }
    function isAdmin() { return isOwner() || (signedIn() && me().role == 'admin'); }
    function canRent() { return signedIn() && me().role in ['admin', 'member']; }
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function near(a, b) { return math.abs(a - b) < 0.005; }
    // ISO (UTC) metni "YYYY-MM-DDTHH:MM:SS.sssZ" → timestamp (dakika hassasiyeti)
    function isoToTs(iso) {
      let d = iso.split('T')[0].split('-');
      let t = iso.split('T')[1].split(':');
      return timestamp.date(int(d[0]), int(d[1]), int(d[2])) + duration.value(int(t[0]) * 60 + int(t[1]), 'm');
    }
    // Türkiye saatiyle (sabit UTC+3) o günün bitişi = ertesi gün 00:00 (TR)
    function trDayEnd(ts) { return (ts + duration.value(3, 'h')).date() + duration.value(21, 'h'); }
    // Kupon türü / değeri (eski kayıtlar: yalnızca rate → yüzde kuponu)
    function couponType(c) { return c.get('type', 'percent'); }
    function couponValue(c) { return c.get('value', c.get('rate', 0)); }
    // Al-Öde bedava kitap sayısı (eski kayıtlar 1)
    function couponFree(c) { return c.get('free', null) == null ? 1 : c.free; }
    // Vitrin Ayarları · settings/showcase.{vitrine|deals|newBooks} == false → o vitrin kapalı (belge/alan yoksa açık)
    function showcaseOn(key) {
      return !exists(path('settings', 'showcase')) || get(path('settings', 'showcase')).data.get(key, true) != false;
    }
    // Kış sezonu açık mı (settings/season.active == 'winter', süreliyse bitiş anı gelmemiş) ·
    // açıkken Günün İndirimi ve Fırsatlar kullanılamaz; Kış Sezonu temalı kitapta Yeni Kitap yerine Kış Fırsatları (winterDeals)
    function winterOn() {
      return exists(path('settings', 'season')) && winterActive(get(path('settings', 'season')).data);
    }
    function winterActive(s) {
      return s.get('active', null) == 'winter' && (s.get('endsAt', null) == null || request.time < s.endsAt);
    }
    // Kış Fırsatları'na yalnızca Kış Sezonu temalı kitap girer (js/core.js → WINTER_THEME_ID ile aynı)
    function winterTheme(b) { return 'kis-sezonu' in b.get('themes', []); }
    // Müze Vitrini: Müze'deki kitap sergide mi (sergilenebilir, son sergilenebilme anı ve bitiş anı gelmemiş, vitrin açık)
    // · sergi süresince kiralanabilir ve puanlanabilir (kitapta exhibitId / exhibitPrice / exhibitEndsAt · exhibitUntil)
    function onExhibit(b) {
      return b.get('museum', false) == true && b.get('exhibitable', true) != false
        && (b.get('exhibitUntil', null) == null || request.time < b.exhibitUntil)
        && b.get('exhibitId', null) is string
        && b.get('exhibitEndsAt', null) is timestamp && request.time < b.exhibitEndsAt
        && showcaseOn('museum');
    }
    // Son sergilenebilme anı geçmiş Müze kitabı (exhibitUntil · bu batch'te kapanır: Sergilenemez, sergi alanları silinir)
    function untilDue(b) {
      return b.get('museum', false) == true && b.get('exhibitUntil', null) is timestamp && b.exhibitUntil <= request.time;
    }
    function untilClosed(a) {
      return a.get('exhibitable', true) == false && !('exhibitUntil' in a) && !('exhibitUntilBy' in a)
        && exhibitCleared(a);
    }
    // Sergi bitiş anı (exhibitEndsAt) geçmiş Müze kitabı · kapanınca sergi alanları silinir
    function exhibitDue(b) {
      return b.get('museum', false) == true && b.get('exhibitEndsAt', null) is timestamp && b.exhibitEndsAt <= request.time;
    }
    function exhibitCleared(a) {
      return !('exhibitId' in a) && !('exhibitPrice' in a) && !('exhibitEndsAt' in a);
    }
    // Kuruş yuvarlaması toleranslı eşitlik (yüzdeyle hesaplanan fiyatlar)
    function nearC(a, b) { return math.abs(a - b) < 0.006; }

    // ---------- Kullanıcılar ----------
    match /users/{userId} {
      allow read: if signedIn();

      // İlk girişte kendi profilini oluşturur: bakiye 0, rol 'member' (ana Kontrolcü 'admin')
      allow create: if signedIn() && userId == uid()
        && request.resource.data.keys().hasOnly(['name', 'email', 'photoURL', 'role', 'balance', 'color', 'joinedAt', 'lastTx', 'lastTxType', 'pointsEarned', 'pointsSpent'])
        // puan defteri boş başlar (alan yoksa Admin kurar)
        && request.resource.data.get('pointsEarned', 0) == 0
        && request.resource.data.get('pointsSpent', 0) == 0
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.balance == 0
        && request.resource.data.lastTx == null
        && request.resource.data.get('lastTxType', null) == null
        && (request.resource.data.role == 'member' || (isOwner() && request.resource.data.role == 'admin'));

      // Admin her şeyi; kullanıcı yalnızca kiralama ödemesi (bakiye düşüşü + lastTx [+ kazanılan puan]),
      // kupon alımı (harcanan puan) veya Profilim'den kendi adını değiştirme
      allow update: if isAdmin() || (userId == uid() && (isPayment() || isCouponBuy() || isChequeOpen() || isRename() || isLogin() || isGiftBalance()));

      // Hediye Kutusu bakiye ödülü: bakiye, aynı batch'te oluşturulan kendi alım kaydındaki tutar kadar artar
      function isGiftBalance() {
        let before = resource.data;
        let after = request.resource.data;
        let tx = after.lastTx;
        return changedKeys().hasOnly(['balance', 'lastTx', 'lastTxType'])
          && after.lastTxType == 'gift'
          && tx is string && tx != before.get('lastTx', null)
          && !exists(path('giftClaims', tx))
          && giftBalanceOk(getAfter(path('giftClaims', tx)).data, before, after);
      }
      function giftBalanceOk(c, before, after) {
        return c.userId == uid() && c.reward.type == 'balance' && near(after.balance, before.balance + c.reward.amount);
      }
      allow delete: if isAdmin();

      function isRename() {
        let name = request.resource.data.name;
        return changedKeys().hasOnly(['name'])
          && name is string && name.size() >= 2 && name.size() <= 60;
      }

      // Son giriş: yalnızca lastLoginAt (ISO metni), sunucu saatinden en fazla 10 dk sapabilir
      function isLogin() {
        let at = request.resource.data.lastLoginAt;
        return changedKeys().hasOnly(['lastLoginAt'])
          && at is string && at.size() == 24
          && isoToTs(at) > request.time - duration.value(10, 'm')
          && isoToTs(at) < request.time + duration.value(10, 'm');
      }

      // ---- Puan defteri: pointsEarned (kazanılan) · pointsSpent (harcanan) ----
      // Defteri olmayan (henüz Admin kurmamış) kullanıcıda alan eklenmez; varsa tam kazanç kadar artar
      function earnedOk(before, after, gain) {
        return (!('pointsEarned' in before) && !('pointsEarned' in after))
          || ('pointsEarned' in after && near(after.pointsEarned, before.get('pointsEarned', 0) + gain));
      }

      // lastTxType hangi koleksiyona bakılacağını söyler (gereksiz erişim çağrısı yapılmaz)
      function isPayment() {
        let before = resource.data;
        let after = request.resource.data;
        let tx = after.lastTx;
        return changedKeys().hasOnly(['balance', 'lastTx', 'lastTxType', 'pointsEarned'])
          && tx is string && tx != before.get('lastTx', null)
          // bedava (%100 indirimli) kiralamada bakiye aynı kalır
          && after.balance is number && after.balance >= 0 && after.balance <= before.balance
          && ((after.lastTxType == 'rental' && paidRental(tx, before, after))
            || (after.lastTxType == 'package' && paidPackage(tx, before, after))
            || (after.lastTxType == 'coupon' && paidCoupon(tx, before, after)));
      }
      // Kuponlu kiralama: kupon bu batch'te kullanılıyor; bakiye kuponun paidTotal'ı kadar düşer
      // (paidTotal'ın kiralama fiyatları toplamına eşit olduğunu kupon kuralı denetler) · puan kazandırmaz
      function paidCoupon(tx, before, after) {
        let c = get(path('coupons', tx)).data;
        let a = getAfter(path('coupons', tx)).data;
        return c.userId == uid() && c.usedAt == null && a.usedAt != null
          && near(after.balance, before.balance - a.paidTotal)
          && earnedOk(before, after, 0);
      }
      // Tekli kiralama: yeni kiralama kaydının fiyatı kadar düşer · indirim (günün / yeni kitap / fırsat / kış fırsatı) puan kazandırır
      function paidRental(tx, before, after) {
        let r = getAfter(path('rentals', tx)).data;
        return !exists(path('rentals', tx))
          && r.userId == uid() && r.purchaseId == null
          && near(after.balance, before.balance - r.price)
          && earnedOk(before, after, r.discountSource in ['deal', 'new', 'custom', 'winter'] ? r.listPrice - r.price : 0);
      }
      // Paket kiralama: yeni satın alım kaydının fiyatı kadar düşer · normal toplam − paket fiyatı puan kazandırır
      function paidPackage(tx, before, after) {
        let p = getAfter(path('offerPurchases', tx)).data;
        return !exists(path('offerPurchases', tx))
          && p.userId == uid()
          && near(after.balance, before.balance - p.price)
          && earnedOk(before, after, p.normalTotal > p.price ? p.normalTotal - p.price : 0);
      }
      // Kupon alımı: harcanan puan kuponun bedeli kadar artar ve kazanılanı aşamaz
      function isCouponBuy() {
        let before = resource.data;
        let after = request.resource.data;
        let tx = after.lastTx;
        return changedKeys().hasOnly(['pointsSpent', 'lastTx', 'lastTxType'])
          && after.lastTxType == 'couponBuy'
          && tx is string && tx != before.get('lastTx', null)
          && 'pointsEarned' in before && 'pointsSpent' in before
          && !exists(path('coupons', tx))
          && boughtCoupon(getAfter(path('coupons', tx)).data, before, after);
      }
      function boughtCoupon(c, before, after) {
        return c.userId == uid()
          && near(after.pointsSpent, before.pointsSpent + c.cost)
          && after.pointsSpent <= before.pointsEarned + 0.005;
      }
      // Puanlı hediye çekini açma: harcanan puan çekin bedeli kadar artar ve kazanılanı aşamaz · çek aynı batch'te açılır
      function isChequeOpen() {
        let before = resource.data;
        let after = request.resource.data;
        let tx = after.lastTx;
        return changedKeys().hasOnly(['pointsSpent', 'lastTx', 'lastTxType'])
          && after.lastTxType == 'chequeOpen'
          && tx is string && tx != before.get('lastTx', null)
          && 'pointsEarned' in before && 'pointsSpent' in before
          && openedCheque(get(path('giftCheques', tx)).data, getAfter(path('giftCheques', tx)).data, before, after);
      }
      function openedCheque(c, a, before, after) {
        return c.userId == uid() && c.openedAt == null && a.openedAt != null
          && near(after.pointsSpent, before.pointsSpent + c.cost)
          && after.pointsSpent <= before.pointsEarned + 0.005;
      }
    }

    // ---------- Kitaplar ----------
    match /books/{bookId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      // Kontrolcü her şeyi; kullanıcı yalnızca boştaki kitabı kendi yeni kiralamasıyla kilitler
      // ya da tarihi gelmiş planlı fiyat değişimini (Fiyat Logu) uygular
      allow update: if isAdmin() || isLock() || isScheduledPrice() || isUntilExpire() || isExhibitExpire();

      // Sergi bitiş anı geldi: siteyi açan herkes sergi alanlarını kitaptan kaldırır (yalnızca bunlar değişir)
      function isExhibitExpire() {
        return signedIn() && exhibitDue(resource.data) && exhibitCleared(request.resource.data)
          && changedKeys().hasOnly(['exhibitId', 'exhibitPrice', 'exhibitEndsAt']);
      }

      // Son sergilenebilme anı geldi: siteyi açan herkes kitabı Sergilenemez yapar (yalnızca sergi alanları değişir)
      // · duyuru (untilNotice) ve sergi bitişi (untilEnded) aynı batch'te bu kapanışa bağlanır
      function isUntilExpire() {
        return signedIn() && untilDue(resource.data) && untilClosed(request.resource.data)
          && changedKeys().hasOnly(['exhibitable', 'exhibitUntil', 'exhibitUntilBy', 'exhibitId', 'exhibitPrice', 'exhibitEndsAt']);
      }

      // Planlı fiyat: logdaki yeni fiyat, logun geçerlilik anı geldiyse ve kitabın son
      // geçerli fiyat anından daha yeniyse uygulanır (eski log yeni fiyatı ezemez)
      function isScheduledPrice() {
        let after = request.resource.data;
        let log = get(path('priceLogs', after.appliedLog)).data;
        return signedIn()
          && changedKeys().hasOnly(['price', 'priceEffectiveAt', 'appliedLog'])
          && after.appliedLog is string
          && log.bookId == resource.data.id
          && log.get('scheduled', false) == true
          && log.effectiveAt <= request.time
          && after.price == log.newPrice
          && after.priceEffectiveAt == log.effectiveAt
          && (resource.data.get('priceEffectiveAt', null) == null || log.effectiveAt > resource.data.priceEffectiveAt);
      }

      function isLock() {
        let after = request.resource.data;
        return canRent()
          && changedKeys().hasOnly(['lockUntil', 'lockBy', 'lockRental'])
          // yalnızca "Kiralık" (durumu olmayan eski kayıtlar = Kiralık) kitap kiralanabilir ·
          // Müze'deki kitap yalnızca Müze Vitrini'nde sergideyken
          && ((resource.data.get('status', 'kiralik') == 'kiralik' && resource.data.get('museum', false) != true)
            || onExhibit(resource.data))
          && (resource.data.get('lockUntil', null) == null || resource.data.lockUntil < request.time)
          && after.lockBy == uid()
          && after.lockUntil is timestamp
          && after.lockUntil <= request.time + duration.value(resource.data.rentalDays + 1, 'd')
          && after.lockRental is string
          // kilit yalnızca bu batch'te oluşturulan yeni bir kiralamaya bağlanabilir
          && !exists(path('rentals', after.lockRental))
          && getAfter(path('rentals', after.lockRental)).data.bookId == resource.data.id;
      }
    }

    // ---------- Kiralamalar ----------
    match /rentals/{rentalId} {
      allow read: if signedIn();
      allow create: if canRent() && validRental();
      allow update, delete: if isAdmin();

      function validRental() {
        let r = request.resource.data;
        let bookPath = path('books', string(r.bookId));
        let book = get(bookPath).data;
        return r.userId == uid()
          && r.bookId is int
          // Müze kitabı yalnızca Müze Vitrini kiralamasıyla (liste fiyatı = sergi fiyatı), diğerleri hiçbir zaman onunla
          && (book.get('museum', false) == true) == (r.discountSource == 'museum')
          && r.listPrice == (book.get('museum', false) == true ? book.get('exhibitPrice', -1) : book.price)
          && r.price is number && r.price >= 0 && r.price <= r.listPrice + 0.001
          && r.returnedAt == null
          // aynı batch'te kitap bu kiralamayla kilitlenmiş olmalı (kitap boştaydı)
          && getAfter(bookPath).data.lockRental == rentalId
          && getAfter(bookPath).data.lockBy == uid()
          // puan çarpanı alanı yazılamaz (eski Kış Fırsatı kayıtlarında kalmıştır)
          && !('pointsMult' in r)
          && (singleRental(r) || packageRental(r) || couponRental(r));
      }
      // Tekli: ödeme kullanıcı belgesinde; indirim standart (en fazla %50), özel fırsat, hediye çeki ya da Müze Vitrini
      function singleRental(r) {
        return r.purchaseId == null && r.offerId == null
          && r.discount is int && r.discount >= 0
          && (standardDiscount(r) || (r.discountSource == 'custom' && vitrineDiscount(r))
            || (r.discountSource == 'winter' && winterDiscount(r))
            || (r.discountSource == 'cheque' && chequeRental(r))
            || (r.discountSource == 'museum' && museumRental(r, get(path('books', string(r.bookId))).data)))
          && getAfter(path('users', uid())).data.lastTx == rentalId;
      }
      // Müze Vitrini: kitap sergide, indirimsiz, fiyat = sergi fiyatı, kayıt bu sergiye ait
      function museumRental(r, b) {
        return onExhibit(b) && r.discount == 0
          && r.price == b.exhibitPrice
          && r.get('exhibitId', null) == b.exhibitId;
      }
      // Hediye çeki: kendi, açılmış, kullanılmamış, süresi dolmamış çek; aynı batch'te bu kiralamayla kullanılır ·
      // fiyat en fazla çek tutarı kadar düşer
      function chequeRental(r) {
        return r.get('chequeId', null) is string
          && chequeRentalOk(r, get(path('giftCheques', r.chequeId)).data, getAfter(path('giftCheques', r.chequeId)).data);
      }
      function chequeRentalOk(r, c, a) {
        return c.userId == uid() && c.usedAt == null && c.openedAt != null && request.time < c.expiresAt
          && a.usedAt != null && a.rentalId == rentalId
          && r.price >= r.listPrice - c.amount - 0.01;
      }
      // Kuponlu: kendi, kullanılmamış, süresi dolmamış kupon; kupon aynı batch'te bu kiralamayı listeler,
      // ödeme kullanıcı belgesinde kupon üzerinden (lastTx = kupon)
      function couponRental(r) {
        return r.purchaseId == null && r.offerId == null
          && r.discountSource == 'coupon' && r.get('couponId', null) is string
          && couponRentalOk(r, get(path('coupons', r.couponId)).data, getAfter(path('coupons', r.couponId)).data);
      }
      function couponRentalOk(r, c, a) {
        let t = couponType(c);
        let v = couponValue(c);
        return c.userId == uid() && c.usedAt == null && request.time < c.expiresAt
          && a.rentalIds is list && rentalId in a.rentalIds
          && r.bookId in a.bookIds
          && getAfter(path('users', uid())).data.lastTx == r.couponId
          && ((t == 'percent' && a.rentalIds.size() == 1 && r.price >= r.listPrice * (100 - v) / 100 - 0.01)
            || (t == 'amount' && a.rentalIds.size() == 1 && r.price >= r.listPrice - v - 0.01)
            // Al-Öde: bedava seçilenler (en ucuzlar) 0, diğerleri tam fiyat
            || (t == 'bogo' && a.rentalIds.size() == v
              && (r.price == r.listPrice || (r.price == 0 && r.bookId in a.freeBookIds))));
      }
      // Kış Fırsatı: kış sezonu ve vitrin açık, kitap Kış Sezonu temalı ve bu sezondan önce eklenmiş
      // (bu kışın kitabı sezon boyunca indirimsiz), Admin'in winterDeals/{kitap} yüzdesinin aynısı
      function winterDiscount(r) {
        return winterOn() && showcaseOn('winter')
          && exists(path('winterDeals', string(r.bookId)))
          && winterDealOk(r, get(path('winterDeals', string(r.bookId))).data, get(path('books', string(r.bookId))).data,
            get(path('settings', 'season')).data);
      }
      function winterDealOk(r, d, b, s) {
        return winterTheme(b) && d.rate is int && d.rate > 0 && r.discount == d.rate
          && (!(b.get('addedAt', null) is string) || isoToTs(b.addedAt) < isoToTs(s.get('startedAt', s.get('changedAt', '1970-01-01T00:00:00.000Z'))))
          && r.price >= r.listPrice * (100 - d.rate) / 100 - 0.01;
      }
      // Günün İndirimi / Yeni Kitap: en fazla %50 · Vitrin Ayarları'nda kapalı vitrinin indirimi kullanılamaz ·
      // kış sezonunda Günün İndirimi yok, Kış Sezonu temalı kitaba Yeni Kitap indirimi yok
      function standardDiscount(r) {
        return r.discountSource in [null, 'deal', 'new']
          && (r.discountSource != 'deal' || !winterOn())
          && (r.discountSource != 'new' || !winterOn() || !winterTheme(get(path('books', string(r.bookId))).data))
          && (r.discountSource != 'deal' || showcaseOn('deals'))
          && (r.discountSource != 'new' || showcaseOn('newBooks'))
          && r.discount <= 50
          && r.price >= r.listPrice * 0.5 - 0.01;
      }
      // Özel Fırsat (eski adı Vitrin İndirimi): Adminin discounts/{kitap} belgesindeki yüzdenin aynısı (süresi dolmamış, vitrin açık)
      function vitrineDiscount(r) {
        let d = get(path('discounts', string(r.bookId))).data;
        return showcaseOn('vitrine') && !winterOn() && d.rate is int && r.discount == d.rate
          && (!('endsAt' in d) || request.time < d.endsAt)
          && r.price >= r.listPrice * (100 - d.rate) / 100 - 0.01;
      }
      // Paket: aynı batch'teki satın alıma ait olmalı
      function packageRental(r) {
        let p = getAfter(path('offerPurchases', r.purchaseId)).data;
        return r.purchaseId is string && r.discountSource == 'offer'
          && p.userId == uid() && p.offerId == r.offerId
          && r.bookId in p.bookIds;
      }
    }

    // ---------- Özel teklif satın alımları ----------
    match /offerPurchases/{purchaseId} {
      allow read: if signedIn();
      allow create: if canRent() && validPurchase();
      allow update, delete: if isAdmin();

      function validPurchase() {
        let p = request.resource.data;
        let offer = get(path('offers', p.offerId)).data;
        return p.userId == uid()
          // yüzdeli paket: fiyat = güncel kitap fiyatları toplamı × (100 − yüzde) / 100 · eski paket: kayıtlı fiyat
          && (offer.get('rate', null) is int
            ? nearC(p.price, packagePriceSum(p.bookIds) * (100 - offer.rate) / 100)
            : p.price == offer.price)
          && p.bookIds == offer.bookIds
          && request.time <= offer.endsAt
          // puan çarpanı alanı yazılamaz (eski kış paketi kayıtlarında kalmıştır)
          && !('pointsMult' in p)
          // normal toplam = paketteki kitapların güncel fiyatları toplamı (puan kazancı buna göre)
          && p.normalTotal is number && near(p.normalTotal, packagePriceSum(p.bookIds))
          && getAfter(path('users', uid())).data.lastTx == purchaseId;
      }
      // En fazla 3 kitap (özel teklif üst sınırı)
      function packageBookPrice(ids, i) { return ids.size() > i ? get(path('books', string(ids[i]))).data.price : 0; }
      function packagePriceSum(ids) { return packageBookPrice(ids, 0) + packageBookPrice(ids, 1) + packageBookPrice(ids, 2); }
    }

    // ---------- Duyurular ----------
    match /announcements/{annId} {
      allow read: if signedIn();
      allow create: if isAdmin() || untilNotice(request.resource.data);
      allow delete: if isAdmin();

      // Son sergilenebilme duyurusu (Bilgilendirme): kitap bu batch'te Sergilenemez yapılırken bir kez atılır ·
      // yazar = tarihi ayarlayan Admin (eski kayıtlarda atan kişi)
      function untilNotice(a) {
        let bookPath = path('books', string(a.museumBookId));
        let b = get(bookPath).data;
        return signedIn()
          && a.keys().hasOnly(['type', 'category', 'title', 'body', 'bookId', 'museumBookId', 'authorId', 'createdAt', 'pinned', 'readBy'])
          && a.museumBookId is int
          && a.type == 'news' && a.category == 'Bilgilendirme' && a.bookId == null
          && a.pinned == false && a.readBy == [] && a.createdAt is string
          && a.title == '"' + b.title + '" artık sergilenemez 🏛️'
          && a.body is string && a.body.size() <= 600
          && a.authorId == b.get('exhibitUntilBy', uid())
          && untilDue(b) && untilClosed(getAfter(bookPath).data);
      }
      // Kontrolcü düzenler; herkes yalnızca kendi uid'ini "okundu" listesine ekleyebilir
      allow update: if isAdmin() || (signedIn()
        && changedKeys().hasOnly(['readBy'])
        && request.resource.data.readBy.toSet().hasAll(resource.data.readBy)
        && request.resource.data.readBy.toSet().difference(resource.data.readBy.toSet()) == [uid()].toSet());
    }

    // ---------- Yalnızca Kontrolcünün yazdığı koleksiyonlar ----------
    match /bookTypes/{typeId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /priceLogs/{logId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /offers/{offerId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      // süresi biten (ya da eski kış paketi) teklifi siteyi açan herkes siler
      allow delete: if isAdmin() || (signedIn() && ('season' in resource.data
        || (resource.data.get('endsAt', null) is timestamp && request.time >= resource.data.endsAt)));
    }
    // Müze Vitrini sergi geçmişi · { bookId, price, rentalDays, startAt, endsAt, endedAt, createdBy } · Admin yazar ve siler
    // (tek tek ya da tümü) · sergi bitiş anı ya da son sergilenebilme anı gelince siteyi açan herkes,
    // kitap aynı batch'te kapanırken süren sergiye yalnızca bitiş anı yazabilir
    match /museumExhibits/{exhibitId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || autoEnded();

      function autoEnded() {
        let bookPath = path('books', string(resource.data.bookId));
        let b = get(bookPath).data;
        let a = getAfter(bookPath).data;
        return signedIn()
          && changedKeys().hasOnly(['endedAt']) && resource.data.endedAt == null
          && request.resource.data.endedAt is string
          && b.get('exhibitId', null) == exhibitId
          && ((untilDue(b) && untilClosed(a)) || (exhibitDue(b) && exhibitCleared(a)));
      }
    }
    // Hediye Kutusu alımı · belge adı = "{boxId}_{gün}_{uid}" (her gün kişi başı tek) · { userId, boxId, day, reward, claimedAt }
    // settings/giftBox: { enabled, boxId, startAt, day2At, rewards[7] } · 1. gün açılışta, sonraki günler day2At'tan itibaren her 24 saatte bir ·
    // yalnızca bugünün ödülü, ayarlardaki ödülün aynısı · ödül aynı batch'te teslim edilir (bakiye / çek / kupon)
    match /giftClaims/{claimId} {
      allow read: if signedIn();
      allow delete: if isAdmin();
      allow create: if signedIn() && exists(path('settings', 'giftBox'))
        && validClaim(request.resource.data, get(path('settings', 'giftBox')).data);

      function validClaim(c, g) {
        return g.get('enabled', false) == true && g.boxId is string
          && g.startAt is timestamp && g.day2At is timestamp
          && request.time >= g.startAt && request.time < g.day2At + duration.value(6, 'd')
          && c.keys().hasOnly(['userId', 'boxId', 'day', 'reward', 'claimedAt'])
          && c.userId == uid() && c.boxId == g.boxId && c.claimedAt is string
          && c.day == giftDay(g)
          && claimId == g.boxId + '_' + string(c.day) + '_' + uid()
          && c.reward == g.rewards[c.day - 1]
          && c.reward.type in ['balance', 'cheque', 'coupon']
          && giftDelivered(c.reward);
      }
      function giftDay(g) {
        return request.time < g.day2At ? 1 : 2 + int((request.time - g.day2At).seconds() / 86400);
      }
      function giftDelivered(r) {
        return r.type == 'balance'
          ? (getAfter(path('users', uid())).data.lastTx == claimId && getAfter(path('users', uid())).data.lastTxType == 'gift')
          : r.type == 'cheque' ? existsAfter(path('giftCheques', claimId)) : existsAfter(path('coupons', claimId));
      }
    }
    // Temalar (kitap etiketleri) · { label, emoji, color, order } · yalnızca Admin yazar
    match /bookThemes/{themeId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    // Kış Fırsatları indirimi · belge adı = kitap numarası · { bookId, rate (0 | 15 | 25 | 50), updatedAt, updatedBy }
    // yalnızca Kış Sezonu temalı kitap (temalı her kitap vitrinde görünür, kaydı yoksa indirimsiz)
    match /winterDeals/{bookId} {
      allow read: if signedIn();
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.rate in [0, 15, 25, 50]
        && string(request.resource.data.bookId) == bookId
        && winterTheme(getAfter(path('books', bookId)).data);
    }
    // Vitrin İndirimi · belge adı = kitap numarası · { bookId, name, rate (1–100, 100 = bedava), endsAt, createdAt, createdBy }
    match /discounts/{bookId} {
      allow read: if signedIn();
      // süresi biten özel fırsatı siteyi açan herkes siler
      allow delete: if isAdmin() || (signedIn()
        && resource.data.get('endsAt', null) is timestamp && request.time >= resource.data.endsAt);
      allow create, update: if isAdmin()
        && request.resource.data.rate is int
        && request.resource.data.rate >= 1 && request.resource.data.rate <= 100
        && request.resource.data.endsAt is timestamp
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && string(request.resource.data.bookId) == bookId
        // yalnızca Kiralık durumdaki kitap (durumu olmayan eski kayıt = Kiralık)
        && get(path('books', bookId)).data.get('status', 'kiralik') == 'kiralik';
    }

    // Reyting · belge adı = "{kitap}_{kullanıcı}" (kitap başına tek oy) · { bookId, userId, score (1–5), rentalId, createdAt, updatedAt }
    // Oy veren, o kitaba ait kendi kiralama kaydını göstermeli (en az 1 kez kiralamış olmalı)
    match /ratings/{ratingId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validRating(request.resource.data);
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == uid());

      function validRating(r) {
        return r.keys().hasOnly(['bookId', 'userId', 'score', 'rentalId', 'createdAt', 'updatedAt'])
          && r.userId == uid()
          && r.bookId is int
          && ratingId == string(r.bookId) + '_' + uid()
          && r.score is int && r.score >= 1 && r.score <= 5
          && r.rentalId is string
          && rentedBy(get(path('rentals', r.rentalId)).data, r.bookId)
          // Müze kitabına yalnızca Müze Vitrini'nde sergideyken puan verilir
          && ratableBook(get(path('books', string(r.bookId))).data);
      }
      function ratableBook(b) { return b.get('museum', false) != true || onExhibit(b); }
      function rentedBy(rent, bookId) { return rent.userId == uid() && rent.bookId == bookId; }
    }

    // Geri bildirim · { userId, message, createdAt, status, replies, adminSeen, lastReplyAt, userSeenAt }
    // Herkes (Admin de) kendi adına yazar; üye yalnızca kendininkini okur ve yalnızca "cevabı gördüm"
    // işaretini günceller; Admin hepsini okur, cevaplar (replies/status/adminSeen) ve siler.
    match /feedback/{feedbackId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == uid());
      allow create: if signedIn() && validFeedback(request.resource.data);
      allow update: if isAdmin()
        || (signedIn() && resource.data.userId == uid() && changedKeys().hasOnly(['userSeenAt'])
          && request.resource.data.userSeenAt is string);
      allow delete: if isAdmin();

      function validFeedback(f) {
        return f.keys().hasOnly(['userId', 'type', 'message', 'createdAt', 'status', 'replies', 'adminSeen', 'lastReplyAt', 'userSeenAt'])
          && f.userId == uid()
          // tür artık seçilmiyor (eski kayıtlarda kalabilir)
          && (!('type' in f) || f.type in ['idea', 'bug', 'other'])
          && f.message is string && f.message.size() >= 3 && f.message.size() <= 1000
          && f.createdAt is string
          && f.status == 'open' && f.replies == [] && f.adminSeen == false
          && f.lastReplyAt == null && f.userSeenAt == null;
      }
    }

    // İade talebi · belge adı = kiralama (kiralama başına tek talep)
    // { userId, rentalId, bookId, amount, reason, createdAt, status, decidedAt, decidedBy, adminNote, userSeenAt }
    // Üye yalnızca kendi indirimsiz, tekli, aktif kiralaması için ödediği tutarla talep açar; yalnızca "sonucu gördüm"
    // işaretini günceller. Admin hepsini okur ve karar verir (bakiye iadesi + kiralama silme Admin yetkisiyle yapılır).
    // Talep yalnızca kiralandığı gün açılabilir: Türkiye saatiyle gece 00:00'a kadar (kural denetler).
    match /refunds/{rentalId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == uid());
      allow create: if canRent() && validRefund(request.resource.data, get(path('rentals', rentalId)).data)
        // 🏛️ Müze'deki kitaplar iade edilemez
        && get(path('books', string(request.resource.data.bookId))).data.get('museum', false) != true;
      allow update: if isAdmin()
        || (signedIn() && resource.data.userId == uid() && resource.data.status != 'pending'
          && changedKeys().hasOnly(['userSeenAt']) && request.resource.data.userSeenAt is string)
        || (signedIn() && resource.data.userId == uid() && refundAutoReject());
      allow delete: if isAdmin();

      // Gün içinde onaylanmayan kendi talebi: Türkiye saatiyle gece 00:00 geçince sahibi "otomatik reddedildi" yazar
      function refundAutoReject() {
        let a = request.resource.data;
        return resource.data.status == 'pending'
          && request.time >= trDayEnd(isoToTs(resource.data.createdAt))
          && changedKeys().hasOnly(['status', 'decidedAt', 'decidedBy', 'adminNote'])
          && a.status == 'rejected' && a.decidedBy == 'auto' && a.decidedAt is string
          && a.adminNote == 'Talep gün içinde onaylanmadığı için otomatik reddedildi.';
      }

      function validRefund(f, r) {
        return f.keys().hasOnly(['userId', 'rentalId', 'bookId', 'amount', 'reason', 'createdAt', 'status', 'decidedAt', 'decidedBy', 'adminNote', 'userSeenAt'])
          && f.userId == uid() && f.rentalId == rentalId
          && r.userId == uid() && r.bookId == f.bookId
          // yalnızca indirimsiz tekli kiralama (indirimli / kuponlu / özel teklif iade edilemez)
          && r.get('purchaseId', null) == null && r.get('offerId', null) == null && r.get('couponId', null) == null
          && r.get('discountSource', null) == null && r.get('discount', 0) == 0
          && r.get('returnedAt', null) == null
          // kiralandığı gün (Türkiye saatiyle gece 00:00'dan önce)
          && request.time < trDayEnd(isoToTs(r.rentedAt))
          && f.amount == r.price
          && f.reason is string && f.reason.size() >= 3 && f.reason.size() <= 500
          && f.createdAt is string
          && f.status == 'pending' && f.decidedAt == null && f.decidedBy == null && f.adminNote == null && f.userSeenAt == null;
      }
    }

    // Hediyelerim kupon mağazası (Kontrolcü ekler/düzenler/siler) · { type, value, free, name, cost, endsAt|null, createdAt, createdBy }
    // percent: %1–100 · amount: ₺ (0–10000] · bogo: value kitap (2–5), free tanesi bedava (1 … value-1, en ucuzlar)
    match /couponShop/{shopId} {
      allow read: if signedIn();
      // süresi biten (ya da eski kış / sezonu biten kış) mağaza kuponunu siteyi açan herkes siler · alınmış kuponlar etkilenmez
      allow delete: if isAdmin() || (signedIn() && ('season' in resource.data
        || (resource.data.get('winterSeason', false) == true && !winterOn())
        || (resource.data.get('endsAt', null) is timestamp && request.time >= resource.data.endsAt)));
      allow create, update: if isAdmin() && validShop(request.resource.data);

      function validShop(s) {
        return ((s.type == 'percent' && s.value is int && s.value >= 1 && s.value <= 100)
            || (s.type == 'amount' && s.value is number && s.value > 0 && s.value <= 10000)
            || (s.type == 'bogo' && s.value is int && s.value >= 2 && s.value <= 5
              && s.free is int && s.free >= 1 && s.free < s.value))
          && (s.type == 'bogo' || s.get('free', null) == null)
          && s.cost is number && s.cost > 0
          && s.name is string && s.name.size() <= 60
          && (s.endsAt == null || s.endsAt is timestamp)
          && !('season' in s);
      }
    }

    // Hediye çeki · Admin gönderir/siler · { userId, amount (₺), cost (puan, 0 = ücretsiz), name, createdAt, createdBy,
    // expiresAt, openedAt, seenAt, usedAt, rentalId } · sahibi okur; yalnızca görüldü işareti, açma (puanlıysa puan defteriyle)
    // ve kullanma (aynı batch'teki kendi yeni kiralamasıyla) yapabilir
    match /giftCheques/{chequeId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == uid());
      allow create: if (isAdmin()
        && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 10000
        && request.resource.data.cost is number && request.resource.data.cost >= 0
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.usedAt == null)
        || (signedIn() && giftCheque(request.resource.data));

      // Hediye Kutusu çek ödülü: belge adı = alım kaydı (aynı batch'te oluşturulan kendi kaydı) · ücretsiz, tutar ödüldeki kadar
      function giftCheque(c) {
        let cl = getAfter(path('giftClaims', chequeId)).data;
        return !exists(path('giftClaims', chequeId)) && cl.userId == uid() && c.userId == uid()
          && cl.reward.type == 'cheque' && c.amount == cl.reward.amount && c.cost == 0
          && c.expiresAt is timestamp && c.expiresAt <= request.time + duration.value(31, 'd')
          && c.usedAt == null && c.get('rentalId', null) == null;
      }
      allow delete: if isAdmin();
      allow update: if isAdmin() || (signedIn() && resource.data.userId == uid() && (chequeSeen() || chequeOpen() || chequeUse()));

      function chequeSeen() {
        return changedKeys().hasOnly(['seenAt']) && request.resource.data.seenAt is string;
      }
      function chequeOpen() {
        let c = resource.data;
        return changedKeys().hasOnly(['openedAt']) && c.openedAt == null && request.resource.data.openedAt is string
          && request.time < c.expiresAt
          && (c.cost == 0 || (getAfter(path('users', uid())).data.lastTx == chequeId
            && getAfter(path('users', uid())).data.lastTxType == 'chequeOpen'));
      }
      function chequeUse() {
        let c = resource.data;
        let a = request.resource.data;
        return changedKeys().hasOnly(['usedAt', 'rentalId'])
          && c.openedAt != null && c.usedAt == null && request.time < c.expiresAt
          && a.usedAt is string && a.rentalId is string
          && !exists(path('rentals', a.rentalId))
          && getAfter(path('rentals', a.rentalId)).data.chequeId == chequeId
          && getAfter(path('rentals', a.rentalId)).data.userId == uid();
      }
    }

    // Alınan kupon · { userId, shopId, type, value, free, name, cost, boughtAt, expiresAt (7 gün), usedAt, rentalIds, bookIds, freeBookIds, paidTotal }
    // Puan yeterliliği istemcide hesaplanır (puan kiralama kayıtlarından türetilir).
    match /coupons/{couponId} {
      allow read: if signedIn();
      allow create: if (canRent() && validCoupon(request.resource.data)) || (signedIn() && giftCoupon(request.resource.data));

      // Hediye Kutusu kupon ödülü: belge adı = alım kaydı (aynı batch'te oluşturulan kendi kaydı) · ücretsiz, ödüldeki kuponun aynısı, 7 gün
      function giftCoupon(c) {
        let cl = getAfter(path('giftClaims', couponId)).data;
        return !exists(path('giftClaims', couponId)) && cl.userId == uid() && c.userId == uid()
          && c.keys().hasOnly(['userId', 'shopId', 'type', 'value', 'free', 'name', 'cost', 'boughtAt', 'expiresAt', 'usedAt', 'rentalIds', 'bookIds', 'freeBookIds', 'paidTotal'])
          && giftCouponMatches(c, cl.reward)
          && c.cost == 0 && c.shopId == null
          && c.expiresAt is timestamp && c.expiresAt <= request.time + duration.value(7, 'd') + duration.value(10, 'm')
          && c.usedAt == null && c.rentalIds == null && c.bookIds == null && c.freeBookIds == null && c.paidTotal == null;
      }
      function giftCouponMatches(c, r) {
        return r.type == 'coupon' && c.type == r.couponType && c.value == r.value
          && c.get('free', null) == r.get('free', null) && c.name == r.get('name', '');
      }
      allow update: if isAdmin() || useCoupon();
      allow delete: if isAdmin();

      // Alım: mağazadaki kuponun birebir kopyası (mağaza süresi dolmamış), 7 gün geçerli, kullanılmamış
      function validCoupon(c) {
        return c.keys().hasOnly(['userId', 'shopId', 'type', 'value', 'free', 'name', 'cost', 'boughtAt', 'expiresAt', 'usedAt', 'rentalIds', 'bookIds', 'freeBookIds', 'paidTotal'])
          && c.userId == uid() && c.shopId is string
          && shopMatches(c, get(path('couponShop', c.shopId)).data)
          && c.expiresAt is timestamp
          && c.expiresAt > request.time + duration.value(6, 'd')
          && c.expiresAt <= request.time + duration.value(7, 'd') + duration.value(10, 'm')
          && c.usedAt == null && c.rentalIds == null && c.bookIds == null && c.freeBookIds == null && c.paidTotal == null
          // aynı batch'te puan defterinden düşülmeli (users → isCouponBuy yeterliliği denetler)
          && getAfter(path('users', uid())).data.lastTx == couponId
          && getAfter(path('users', uid())).data.lastTxType == 'couponBuy';
      }
      function shopMatches(c, s) {
        return c.type == s.type && c.value == s.value && c.cost == s.cost && c.name == s.name
          && c.get('free', null) == s.get('free', null)
          // eski kış kuponları (season damgalı) artık alınamaz
          && !('season' in s)
          // kış kuponu (winterSeason) yalnızca kış sezonu açıkken
          && (s.get('winterSeason', false) != true || winterOn())
          && (s.endsAt == null || request.time < s.endsAt);
      }

      // Kullanım: yalnızca sahibi, bir kez, süresi dolmadan; aynı batch'teki yeni kiralamalarla.
      // paidTotal = kiralamaların fiyat toplamı · Al-Öde'de bedava kitap en düşük fiyatlı olmalı.
      function useCoupon() {
        let c = resource.data;
        let a = request.resource.data;
        let n = couponType(c) == 'bogo' ? couponValue(c) : 1;
        return c.userId == uid() && c.usedAt == null && request.time < c.expiresAt
          && changedKeys().hasOnly(['usedAt', 'rentalIds', 'bookIds', 'freeBookIds', 'paidTotal'])
          && a.usedAt is string
          && a.rentalIds is list && a.rentalIds.size() == n
          && a.bookIds is list && a.bookIds.size() == n
          && newRentals(a.rentalIds)
          && a.paidTotal is number && near(a.paidTotal, rentalsTotal(a.rentalIds))
          && (couponType(c) != 'bogo' || validFree(a.bookIds, a.freeBookIds, couponFree(c)))
          && getAfter(path('users', uid())).data.lastTx == couponId
          && getAfter(path('users', uid())).data.lastTxType == 'coupon';
      }
      // En fazla 5 kiralama (Al-Öde üst sınırı)
      function rentalAt(ids, i) { return getAfter(path('rentals', ids[i])).data; }
      function newRentalAt(ids, i) {
        return ids.size() <= i || (!exists(path('rentals', ids[i])) && rentalAt(ids, i).userId == uid() && rentalAt(ids, i).couponId == couponId);
      }
      function newRentals(ids) {
        return newRentalAt(ids, 0) && newRentalAt(ids, 1) && newRentalAt(ids, 2) && newRentalAt(ids, 3) && newRentalAt(ids, 4);
      }
      function priceAt(ids, i) { return ids.size() > i ? rentalAt(ids, i).price : 0; }
      function rentalsTotal(ids) {
        return priceAt(ids, 0) + priceAt(ids, 1) + priceAt(ids, 2) + priceAt(ids, 3) + priceAt(ids, 4);
      }
      // Al-Öde: tam f farklı bedava kitap, hepsi seçilenler arasında ve hiçbir ücretli kitap bedavalardan ucuz değil
      function validFree(ids, free, f) {
        return free is list && free.size() == f && free.toSet().size() == f
          && ids.toSet().hasAll(free)
          && cheapestFree(ids, free, maxFreePrice(free));
      }
      function bookPrice(id) { return get(path('books', string(id))).data.price; }
      function bigger(a, b) { return a > b ? a : b; }
      function freePriceAt(free, i) { return free.size() > i ? bookPrice(free[i]) : 0; }
      // bedava en fazla 4 kitap (Al-Öde en fazla 5 kitap)
      function maxFreePrice(free) {
        return bigger(bigger(freePriceAt(free, 0), freePriceAt(free, 1)), bigger(freePriceAt(free, 2), freePriceAt(free, 3)));
      }
      function paidNotCheaper(ids, free, i, m) { return ids.size() <= i || ids[i] in free || bookPrice(ids[i]) >= m; }
      function cheapestFree(ids, free, m) {
        return paidNotCheaper(ids, free, 0, m) && paidNotCheaper(ids, free, 1, m) && paidNotCheaper(ids, free, 2, m)
          && paidNotCheaper(ids, free, 3, m) && paidNotCheaper(ids, free, 4, m);
      }
    }
    // Uygulama ayarları · settings/deals: günün indirimi seçimi · settings/showcase: Vitrin Ayarları (aç / kapat)
    match /settings/{settingId} {
      allow read: if signedIn();
      allow write: if isAdmin();
      // Süreli sezon bitti: siteyi açan herkes sezonu kapatır (yalnızca kapatma, başka ayar değişmez)
      allow update: if signedIn() && settingId == 'season'
        && resource.data.get('endsAt', null) is timestamp && resource.data.endsAt <= request.time
        && changedKeys().hasOnly(['active', 'endsAt', 'changedAt', 'changedBy'])
        && request.resource.data.active == null && request.resource.data.endsAt == null
        && request.resource.data.changedBy == 'auto' && request.resource.data.changedAt is string;
    }

    // Diğer her şey kapalı
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
